  "type": "module",
  "bugs": {
    "url": "https://github.com/alimagdye/background-job/issues"
  },
  "homepage": "https://github.com/alimagdye/background-job#readme",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
